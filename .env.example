# --- LLM providers ---
# Ordered fallback chain used by app/core/llm — first configured provider
# wins; if it fails or hits a rate limit after retries, the next one is
# tried automatically. Supported names: gemini, groq, ollama
LLM_PROVIDER_ORDER=gemini,groq

# Gemini (primary) — free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest
GEMINI_WRITER_MODEL=gemini-flash-latest
# Daily job scoring uses its own model so it doesn't eat the brief pipeline's
# per-model free-tier quota (gemini-flash-latest was 5 req/min, 20 req/day in Oct 2026).
GEMINI_SCORING_MODEL=gemini-flash-lite-latest

# Groq (fallback) — free-tier key from https://console.groq.com
# Groq's free model catalog changes over time; check https://console.groq.com/docs/models
# if these 404.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WRITER_MODEL=openai/gpt-oss-120b
GROQ_SCORING_MODEL=openai/gpt-oss-20b

# Ollama (optional, local-only — requires `ollama serve` running on your
# machine; not in LLM_PROVIDER_ORDER by default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
# "memory://" for a single dev process; point at Redis for multi-worker prod
# (e.g. redis://redis:6379/1 — separate DB index from Celery's broker/backend)
RATE_LIMIT_STORAGE_URI=memory://

# --- Object storage (optional, Phase 9) ---
# Blank = gracefully skipped (no export upload, no error). docker-compose
# sets these to point at the local MinIO container automatically.
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=researchai-reports

# --- Auth ---
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The app logs a startup warning if this is left at the default.
SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Job Search Assistant ---
# Personal files (git-ignored; copy from the *.example.* files):
PROFILE_PATH=config/profile.yaml
COMPANIES_PATH=config/companies.yaml
MASTER_RESUME_PATH=data/private/master_resume.yaml

# Sources to run (comma-separated). adzuna skips itself without a key.
JOB_SOURCES=greenhouse,lever,ashby,remotive,remoteok,weworkremotely,himalayas,arbeitnow,adzuna

# Adzuna (optional) — free key from https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# LLM scoring — only the rule-ranked top N per run, in batches, with a pause
# between calls to stay inside free-tier requests-per-minute limits.
SCORING_MAX_JOBS=30
SCORING_BATCH_SIZE=10
SCORING_MIN_INTERVAL_SECONDS=13

# --- Daily digest ---
DIGEST_TOP_N=10
DIGEST_MIN_SCORE=40
DIGEST_MAX_AGE_DAYS=7
# Base URL of the React app, for "Open in app" links in the digest.
APP_BASE_URL=http://localhost:5173

# Telegram: create a bot with @BotFather (gives the token), send your bot any
# message, then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy
# message.chat.id. Verify with: python -m app.cli test-digest
DIGEST_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Email via Gmail SMTP: needs 2-Step Verification + an App Password
# (https://myaccount.google.com/apppasswords) — NOT your normal password.
DIGEST_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password-here
DIGEST_EMAIL_FROM=you@gmail.com
DIGEST_EMAIL_TO=you@gmail.com
