# --- LLM providers ---
# Ordered fallback chain used by app/core/llm — first configured provider
# wins; if it fails or hits a rate limit after retries, the next one is
# tried automatically. Supported names: gemini, groq, ollama
LLM_PROVIDER_ORDER=gemini,groq

# Gemini (primary) — free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_WRITER_MODEL=gemini-2.0-flash

# Groq (fallback) — free-tier key from https://console.groq.com
# Groq's free model catalog changes over time; check https://console.groq.com/docs/models
# if these 404.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WRITER_MODEL=openai/gpt-oss-120b

# Ollama (optional, local-only — requires `ollama serve` running on your
# machine; not in LLM_PROVIDER_ORDER by default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
# "memory://" for a single dev process; point at Redis for multi-worker prod
# (e.g. redis://redis:6379/1 — separate DB index from Celery's broker/backend)
RATE_LIMIT_STORAGE_URI=memory://

# --- Auth ---
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The app logs a startup warning if this is left at the default.
SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
